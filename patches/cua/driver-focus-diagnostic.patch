+fn write_focus_diagnostic(mut out: impl std::io::Write, value: &serde_json::Value) {
+    // Diagnostic output must not panic or replace the original action result.
+    let _ = writeln!(out, "CUAGENT_FOCUS_DIAGNOSTIC {}", value);
+}
+
+pub(crate) fn focus_diagnostic(stage: &str, pid: libc::pid_t, wid: u32, details: serde_json::Value) {
+    if std::env::var("CUAGENT_FOCUS_DIAGNOSTICS").as_deref() != Ok("1") {
+        return;
+    }
+    let value = serde_json::json!({
+        "version": 1, "stage": stage, "target_pid": pid, "target_window_id": wid,
+        "unix_ms": std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)
+            .ok().map(|d| d.as_millis()),
+        "frontmost_pid": crate::apps::frontmost_pid(),
+        "focused_window_id": crate::ax::bindings::focused_window_id_of_pid(pid),
+        "details": details
+    });
+    write_focus_diagnostic(std::io::stderr().lock(), &value);
+}
+
+#[cfg(test)]
+mod cuagent_focus_diagnostic_tests {
+    use super::write_focus_diagnostic;
+
+    #[test]
+    fn private_json_line_preserves_unknown_and_stage() {
+        let value = serde_json::json!({"stage":"preserve_existing", "frontmost_pid":null});
+        let mut bytes = Vec::new();
+        write_focus_diagnostic(&mut bytes, &value);
+        let line = String::from_utf8(bytes).unwrap();
+        assert_eq!(line.lines().count(), 1);
+        let parsed: serde_json::Value = serde_json::from_str(
+            line.trim_end().strip_prefix("CUAGENT_FOCUS_DIAGNOSTIC ").unwrap()).unwrap();
+        assert_eq!(parsed, value);
+    }
+
+    #[test]
+    fn broken_output_does_not_panic() {
+        struct Broken;
+        impl std::io::Write for Broken {
+            fn write(&mut self, _: &[u8]) -> std::io::Result<usize> {
+                Err(std::io::Error::new(std::io::ErrorKind::BrokenPipe, "closed"))
+            }
+            fn flush(&mut self) -> std::io::Result<()> { Ok(()) }
+        }
+        write_focus_diagnostic(Broken, &serde_json::json!({"stage":"action_returned"}));
+    }
+}
