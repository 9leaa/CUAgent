+//! Fail-closed preflight for global HID pixel clicks, not a delivery guarantee.
+use crate::ax::bindings::*;
+use core_foundation::{base::{CFEqual, CFGetTypeID, CFRelease, CFTypeRef, TCFType}, string::CFString};
+use std::time::{Duration, Instant};
+
+#[link(name = "ApplicationServices", kind = "framework")]
+extern "C" {
+    fn AXUIElementCreateSystemWide() -> AXUIElementRef;
+    fn AXUIElementGetPid(element: AXUIElementRef, pid: *mut i32) -> AXError;
+}
+
+struct OwnedElement(AXUIElementRef);
+impl Drop for OwnedElement {
+    fn drop(&mut self) { unsafe { CFRelease(self.0 as CFTypeRef) }; }
+}
+
+fn checked_point_window(status: AXError, window_id: u32) -> anyhow::Result<u32> {
+    anyhow::ensure!(status == kAXErrorSuccess && window_id != 0,
+        "point terminal window unavailable: window_status={status}, window_id={window_id}");
+    Ok(window_id)
+}
+
+fn attribute_present(status: AXError, present: bool, element_type: bool, name: &str) -> anyhow::Result<bool> {
+    if status == -25212 || status == -25205 {
+        anyhow::ensure!(!present, "point attribute inconsistent result: {name}");
+        return Ok(false);
+    }
+    anyhow::ensure!(status == kAXErrorSuccess, "point attribute failed: {name}, status={status}");
+    anyhow::ensure!(present, "point attribute empty success: {name}");
+    anyhow::ensure!(element_type, "point attribute unexpected type: {name}");
+    Ok(true)
+}
+
+fn terminal_role(role: &str, window_only: bool) -> anyhow::Result<bool> {
+    if role == "AXWindow" || role == "AXSheet" { return Ok(true); }
+    anyhow::ensure!(!window_only, "point window attribute is not a window");
+    anyhow::ensure!(role.starts_with("AX") && role.len() > 2 && role != "AXUnknown" && role != "AXApplication",
+        "point ancestry role boundary");
+    Ok(false)
+}
+
+enum PointStep<E> {
+    Window(u32),
+    Next(E, bool), // true means an AXWindow attribute, not an ancestor
+}
+
+// A real seam: the policy owns nodes, the adapter owns native reads/references.
+fn resolve_point_chain<E>(
+    start: E, expected_pid: i32,
+    mut read: impl FnMut(&E, bool) -> anyhow::Result<(i32, PointStep<E>)>,
+    same: impl Fn(&E, &E) -> bool,
+    expired: impl Fn() -> bool,
+) -> anyhow::Result<u32> {
+    let mut seen = Vec::new();
+    let mut current = start;
+    let mut window_only = false;
+    for _ in 0..40 {
+        anyhow::ensure!(!expired(), "point ancestry timeout");
+        anyhow::ensure!(!seen.iter().any(|old| same(old, &current)), "point ancestry cycle");
+        let (pid, step) = read(&current, window_only)?;
+        anyhow::ensure!(!expired(), "point ancestry timeout");
+        anyhow::ensure!(pid == expected_pid && pid > 0, "point ancestry owner mismatch");
+        match step {
+            PointStep::Window(id) => {
+                anyhow::ensure!(id != 0, "point ancestry zero window");
+                return Ok(id); // Never climb past a sheet or a different window.
+            }
+            PointStep::Next(next, direct_window) => {
+                anyhow::ensure!(!window_only, "point window attribute is not a window");
+                seen.push(current);
+                current = next;
+                window_only = direct_window;
+            }
+        }
+    }
+    anyhow::bail!("point ancestry depth exceeded")
+}
+
+fn point_element_attr(element: AXUIElementRef, name: &str, trace: &mut serde_json::Value) -> anyhow::Result<Option<OwnedElement>> {
+    let attr = CFString::new(name);
+    let mut value: CFTypeRef = std::ptr::null();
+    let status = unsafe { AXUIElementCopyAttributeValue(element, attr.as_concrete_TypeRef(), &mut value) };
+    // RAII releases even an unexpected CF type or non-null error result.
+    let owned = (!value.is_null()).then(|| OwnedElement(value as AXUIElementRef));
+    let valid_type = !value.is_null() && unsafe { CFGetTypeID(value) == AXUIElementGetTypeID() };
+    trace[name] = serde_json::json!({"status":status,"present":owned.is_some(),"element_type":valid_type});
+    if !attribute_present(status, owned.is_some(), valid_type, name)? { return Ok(None); }
+    Ok(owned)
+}
+
+fn native_point_step(element: &OwnedElement, window_only: bool, expected_pid: i32,
+    trace: &mut serde_json::Value) -> anyhow::Result<(i32, PointStep<OwnedElement>)> {
+    // Set only this retained element's messaging timeout, never system-wide.
+    let status = unsafe { AXUIElementSetMessagingTimeout(element.0, 0.1) };
+    anyhow::ensure!(status == kAXErrorSuccess, "point element timeout setup failed: {status}");
+    let mut pid = 0;
+    let status = unsafe { AXUIElementGetPid(element.0, &mut pid) };
+    trace["pid"] = serde_json::json!(pid);
+    trace["pid_status"] = serde_json::json!(status);
+    anyhow::ensure!(status == kAXErrorSuccess && pid > 0, "point element owner unavailable: {status}");
+    anyhow::ensure!(pid == expected_pid, "point ancestry owner mismatch");
+    let role = unsafe { copy_string_attr(element.0, "AXRole") }
+        .ok_or_else(|| anyhow::anyhow!("point element role unavailable"))?;
+    // Log only fixed categories, never an app-supplied arbitrary role string.
+    trace["role"] = serde_json::json!(match role.as_str() {
+        "AXWindow"=>"window", "AXSheet"=>"sheet", "AXApplication"=>"application",
+        "AXUnknown"=>"unknown", _=>"other",
+    });
+    if terminal_role(&role, window_only)? {
+        let mut id = 0;
+        let status = unsafe { _AXUIElementGetWindow(element.0, &mut id) };
+        trace["window_status"] = serde_json::json!(status);
+        trace["window_id"] = serde_json::json!(id);
+        return Ok((pid, PointStep::Window(checked_point_window(status, id)?)));
+    }
+    if let Some(window) = point_element_attr(element.0, "AXWindow", trace)? {
+        trace["route"] = serde_json::json!("window_attribute");
+        return Ok((pid, PointStep::Next(window, true)));
+    }
+    let parent = point_element_attr(element.0, "AXParent", trace)?
+        .ok_or_else(|| anyhow::anyhow!("point ancestry parent missing"))?;
+    trace["route"] = serde_json::json!("parent");
+    Ok((pid, PointStep::Next(parent, false)))
+}
+
+fn system_point_target(x: f64, y: f64, trace: &mut Vec<serde_json::Value>) -> anyhow::Result<(i32, u32)> {
+    // Unlike an application-scoped hit test, this asks the desktop which app
+    // currently owns the element at the point. Never change global AX timeout.
+    let system = unsafe { AXUIElementCreateSystemWide() };
+    anyhow::ensure!(!system.is_null(), "system point query unavailable");
+    let system = OwnedElement(system);
+    let mut hit = std::ptr::null_mut();
+    let status = unsafe { AXUIElementCopyElementAtPosition(system.0, x as f32, y as f32, &mut hit) };
+    let hit = (!hit.is_null()).then(|| OwnedElement(hit));
+    anyhow::ensure!(status == kAXErrorSuccess, "system point query failed: {status}");
+    let hit = hit.ok_or_else(|| anyhow::anyhow!("system point query returned no element"))?;
+    let mut pid = 0;
+    let status = unsafe { AXUIElementGetPid(hit.0, &mut pid) };
+    anyhow::ensure!(status == kAXErrorSuccess && pid > 0, "system point owner unavailable");
+    let started = Instant::now();
+    let id = resolve_point_chain(hit, pid, |element, window_only| {
+        let mut row = serde_json::json!({"depth":trace.len(),"window_only":window_only});
+        let result = native_point_step(element, window_only, pid, &mut row);
+        trace.push(row);
+        result
+    },
+        |a, b| unsafe { CFEqual(a.0 as CFTypeRef, b.0 as CFTypeRef) != 0 },
+        || started.elapsed() >= Duration::from_secs(2))
+        .map_err(|error| anyhow::anyhow!("point owner pid={pid}: {error}"))?;
+    Ok((pid, id))
+}
+
+fn deliver_if_matching(
+    pid: i32, wid: u32, hit: anyhow::Result<(i32, u32)>,
+    action: impl FnOnce() -> anyhow::Result<()>,
+) -> anyhow::Result<()> {
+    anyhow::ensure!(hit? == (pid, wid), "foreground point does not hit exact target window");
+    action()
+}
+
+pub(crate) fn with_exact_point_target(
+    pid: i32, wid: u32, x: f64, y: f64,
+    action: impl FnOnce() -> anyhow::Result<()>,
+) -> anyhow::Result<()> {
+    anyhow::ensure!(pid > 0 && wid != 0 && x.is_finite() && y.is_finite()
+        && (x as f32).is_finite() && (y as f32).is_finite(), "invalid foreground point target");
+    let mut trace = Vec::new();
+    let hit = system_point_target(x, y, &mut trace);
+    super::skylight::focus_diagnostic("point_preflight", pid, wid,
+        serde_json::json!({"x":x,"y":y,"hit":hit.as_ref().ok(),"query_ok":hit.is_ok(),
+            "query_error":hit.as_ref().err().map(|error| error.to_string()),"ancestry":trace}));
+    // A focus/window change can still race this check. Post-action observation
+    // remains mandatory; this does not claim the eventual event receiver.
+    deliver_if_matching(pid, wid, hit, action)
+}
+
