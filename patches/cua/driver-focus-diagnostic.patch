+// An application's remembered AX window is not proof that make-key succeeded.
+// This gate prevents delivery on an explicit failure; it does not prove desktop
+// hit-testing or rule out a focus change after the check.
+fn run_after_exact_focus(
+    establish: impl FnOnce() -> bool,
+    focused: impl FnOnce() -> bool,
+    action: impl FnOnce() -> anyhow::Result<()>,
+) -> anyhow::Result<()> {
+    if !establish() {
+        anyhow::bail!("exact target window could not become key for foreground HID delivery");
+    }
+    if !focused() {
+        anyhow::bail!("exact target window did not become focused for foreground HID delivery");
+    }
+    action()
+}
+
+#[cfg(test)]
+mod exact_focus_delivery_tests {
+    use super::run_after_exact_focus;
+    use std::cell::RefCell;
+
+    #[test]
+    fn failed_make_key_never_checks_stale_focus_or_delivers() {
+        let error = run_after_exact_focus(
+            || false,
+            || panic!("stale focus must not admit input"),
+            || panic!("input must not be sent"),
+        ).unwrap_err();
+        assert_eq!(error.to_string(), "exact target window could not become key for foreground HID delivery");
+    }
+
+    #[test]
+    fn missing_focus_never_delivers() {
+        let error = run_after_exact_focus(|| true, || false, || panic!("input must not be sent"))
+            .unwrap_err();
+        assert_eq!(error.to_string(), "exact target window did not become focused for foreground HID delivery");
+    }
+
+    #[test]
+    fn success_is_ordered_and_action_error_is_not_retried() {
+        let events = RefCell::new(Vec::new());
+        let error = run_after_exact_focus(
+            || { events.borrow_mut().push("key"); true },
+            || { events.borrow_mut().push("focus"); true },
+            || { events.borrow_mut().push("action"); anyhow::bail!("original action failure") },
+        ).unwrap_err();
+        assert_eq!(error.to_string(), "original action failure");
+        assert_eq!(*events.borrow(), ["key", "focus", "action"]);
+        assert!(run_after_exact_focus(|| true, || true, || Ok(())).is_ok());
+    }
+}
