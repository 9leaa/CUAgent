+fn point_guard_bundle(path: &Path) -> Option<&Path> {
+    if path.file_name()?.to_str()? != "cua-driver-pointguard" { return None; }
+    let macos = path.parent()?;
+    let contents = macos.parent()?;
+    let app = contents.parent()?;
+    (macos.file_name()?.to_str()? == "MacOS"
+        && contents.file_name()?.to_str()? == "Contents"
+        && app.file_name()?.to_str()? == "CuaDriverPointGuard.app").then_some(app)
+}
+
+fn current_point_guard_bundle() -> Option<std::path::PathBuf> {
+    let path = std::fs::canonicalize(std::env::current_exe().ok()?).ok()?;
+    point_guard_bundle(&path).map(Path::to_path_buf)
+}
