+
+    #[test]
+    fn accessory_discovery_requires_explicit_bounded_pid() {
+        for value in [json!({"include_accessory_windows":true}), json!({"include_accessory_windows":true,"pid":2147483648u32})] {
+            let input: ListWindowsInput = serde_json::from_value(value).unwrap();
+            assert_eq!(input.validate().unwrap_err(), "accessory discovery requires an explicit positive macOS PID");
+        }
+        let good: ListWindowsInput = serde_json::from_value(json!({"include_accessory_windows":true,"pid":426})).unwrap();
+        good.validate().unwrap();
+        let old: ListWindowsInput = serde_json::from_value(json!({})).unwrap();
+        old.validate().unwrap();
+        assert_eq!(serde_json::to_value(old).unwrap(), json!({}));
+        for bad in [json!({"include_accessory_windows":"true","pid":426}), json!({"include_accessory_windows":true,"pid":-1})] {
+            assert!(serde_json::from_value::<ListWindowsInput>(bad).is_err());
+        }
+    }
+}
