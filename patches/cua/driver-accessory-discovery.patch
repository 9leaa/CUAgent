+/// Opt-in discovery only; no AX reachability or input authorization inferred.
+/// Space metadata is unknown for this all-layer enumeration.
+pub(crate) fn visible_accessory_windows_for_pid(pid: i32) -> WindowEnumeration {
+    let mut result = enumerate_windows(
+        kCGWindowListOptionOnScreenOnly | kCGWindowListExcludeDesktopElements,
+        LayerFilter::AnyLayer,
+    );
+    retain_visible_pid(&mut result.windows, pid);
+    result
+}
+
+fn retain_visible_pid(windows: &mut Vec<WindowInfo>, pid: i32) {
+    windows.retain(|window| window.pid == pid && window.is_on_screen);
+}
