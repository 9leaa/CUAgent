+        assert_eq!(permission_identity_observation_window("com.trycua.driver.pointguard").as_secs(), 10);
+    }
+
+    #[test]
+    fn other_products_do_not_wait() {
+        for id in ["com.trycua.driver", "com.trycua.driver.local", "", "com.trycua.driver.pointguard.other"] {
