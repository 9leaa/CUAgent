+/** Rewrite diagnostic stack text without replacing the resolver error or its code. */
+function rewriteErrorStack(error: Error, originalMessage: string, message: string): void {
+  const stack = error.stack
+  if (stack === undefined) return
+  const rewritten = stack.replace(originalMessage, message)
+  if (rewritten === stack) return
+  try {
+    error.stack = rewritten
+  } catch (assignmentError) {
+    try {
+      Object.defineProperty(error, 'stack', { value: rewritten, writable: true, configurable: true })
+    } catch (definitionError) {
+      // A non-configurable stack is only a diagnostic loss; keep the original resolver error.
+      void assignmentError
+      void definitionError
+    }
+  }
+}
